# 数据开发平台部署环境变量
# 复制为 .env 后修改实际值

# PostgreSQL 密码
POSTGRES_PASSWORD=change_me_strong_password

# MinIO root 用户名/密码
MINIO_ROOT_USER=daaspro
MINIO_ROOT_PASSWORD=change_me_strong_password

# ETL Worker 内部通信 Token
DAASPRO_ETL_WORKER_TOKEN=change_me_random_token

# 数据源密码加密密钥（32字节 base64，用 openssl rand -base64 32 生成）
DAASPRO_CRYPTO_KEY=

# Web 对外端口（默认 80）
WEB_PORT=80
